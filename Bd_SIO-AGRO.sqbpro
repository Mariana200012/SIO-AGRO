DROP TABLE IF EXISTS USUARIOS;

-- 2. Creamos la tabla con la sintaxis correcta para SQLite
CREATE TABLE USUARIOS (
    id_usuario INTEGER PRIMARY KEY AUTOINCREMENT,
    id_area INTEGER,
    nombre_usuario VARCHAR(150) NOT NULL,
    puesto VARCHAR(100),
    nip_firma VARCHAR(50)
);

-- 3. Insertamos a todos tus usuarios con sus IDs correctos
INSERT INTO USUARIOS (id_usuario, id_area, nombre_usuario, puesto, nip_firma) VALUES 
(1, 1, 'Luisa Morales', 'Operador', '1234'),
(2, 2, 'Raul Flores', 'Operador', '4321'),
(3, 5, 'Jose Abdon', 'Administrador', '1425'),
(4, 3, 'Dalila', 'Supervisor de empaque', '4152'),
(5, 4, 'Marcela', 'Analista', '6352'),
(6, 1, 'Guadalupe Sanchez', 'Operador', '7894'),
(7, 1, 'Saul Olveras', 'Operador', '8596');</sql><current_tab id="0"/></tab_sql></sqlb_project>
