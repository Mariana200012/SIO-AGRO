    &quot;id_asistencia&quot; INTEGER PRIMARY KEY AUTOINCREMENT,
    &quot;id_usuario&quot; INTEGER NOT NULL,
    &quot;fecha&quot; DATE NOT NULL,
    &quot;hora_entrada&quot; TIME,
    &quot;hora_salida&quot; TIME,
    &quot;estatus&quot; TEXT DEFAULT 'En turno',
    FOREIGN KEY(&quot;id_usuario&quot;) REFERENCES &quot;USUARIOS&quot;(&quot;id_usuario&quot;)
);</sql><current_tab id="0"/></tab_sql></sqlb_project>
