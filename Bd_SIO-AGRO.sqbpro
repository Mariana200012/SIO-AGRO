_columns="0"><sort/><column_widths><column index="1" value="70"/><column index="2" value="80"/><column index="3" value="82"/><column index="4" value="93"/><column index="5" value="57"/><column index="6" value="55"/><column index="7" value="51"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="PROD_DETALLE_CHRYSOPA" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="82"/><column index="2" value="63"/><column index="3" value="53"/><column index="4" value="77"/><column index="5" value="159"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">-- 1. Tabla para PRE-Parasitismo (Formulario simple)
CREATE TABLE PRE_PARASITISMO (
    id_pre INTEGER PRIMARY KEY AUTOINCREMENT,
    id_lote TEXT NOT NULL,
    viables INTEGER NOT NULL,
    id_operador INTEGER NOT NULL,
    fecha_registro TEXT NOT NULL
);

-- 2. Tabla CABECERA para POST-Parasitismo (El ticket general)
CREATE TABLE POST_PARASITISMO_CABECERA (
    id_cabecera INTEGER PRIMARY KEY AUTOINCREMENT,
    id_lote TEXT NOT NULL,
    id_operador INTEGER NOT NULL,
    fecha_registro TEXT NOT NULL
);

-- 3. Tabla DETALLE para POST-Parasitismo (Los 10 garbanzos por ticket)
CREATE TABLE POST_PARASITISMO_DETALLE (
    id_detalle INTEGER PRIMARY KEY AUTOINCREMENT,
    id_cabecera INTEGER,
    numero_garbanzo INTEGER,
    gorg_nacidos INTEGER,
    gorg_pupas INTEGER,
    cat_negros INTEGER,
    cat_combinados INTEGER,
    cat_ambar INTEGER,
    FOREIGN KEY(id_cabecera) REFERENCES POST_PARASITISMO_CABECERA(id_cabecera)
);</sql><current_tab id="0"/></tab_sql></sqlb_project>
